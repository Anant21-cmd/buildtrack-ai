generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                 String          @id @default(uuid())
  name               String
  regNumber          String          @unique
  ownerName          String
  email              String          @unique
  phone              String
  address            String
  status             CompanyStatus   @default(PENDING)
  rejectionReason    String?
  documentsSubmitted String[]        @default([])
  registeredAt       DateTime        @default(now())
  approvedAt         DateTime?
  updatedAt          DateTime        @updatedAt
  dailyProgress      DailyProgress[]
  equipment          Equipment[]
  expenses           Expense[]
  materials          Material[]
  notifications      Notification[]
  projects           Project[]
  users              User[]
  vendors            Vendor[]
  workers            Worker[]
}

model User {
  id                      String         @id @default(uuid())
  name                    String
  email                   String         @unique
  phone                   String?
  password                String
  role                    Role
  isEmailVerified         Boolean        @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  avatar                  String?
  companyId               String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  contractorAttendances   Attendance[]   @relation("ContractorAttendances")
  recordedAttendances     Attendance[]   @relation("RecordedAttendances")
  verifiedAttendances     Attendance[]   @relation("VerifiedAttendances")
  notifications           Notification[]
  tasks                   Task[]
  company                 Company?       @relation(fields: [companyId], references: [id])
  contractorWorkers       Worker[]       @relation("ContractorWorkers")
}

model Project {
  id                 String                      @id @default(uuid())
  name               String
  code               String?
  client             String?
  location           String
  latitude           Float?
  longitude          Float?
  radiusMeters       Float?                      @default(250)
  description        String?
  budget             Float                       @default(0)
  spent              Float                       @default(0)
  progress           Float                       @default(0)
  status             ProjectStatus               @default(PLANNING)
  isArchived         Boolean                     @default(false)
  companyId          String
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  attendances        Attendance[]
  dailyProgress      DailyProgress[]
  dailyReports       DailySiteReport[]
  equipment          Equipment[]
  expenses           Expense[]
  issues             Issue[]
  materialReqs       MaterialRequest[]
  company            Company                     @relation(fields: [companyId], references: [id])
  allocations        ProjectMaterialAllocation[]
  purchaseOrders     PurchaseOrder[]
  qualityInspections QualityInspection[]
  safetyReports      SafetyReport[]
  sitePhotos         SitePhoto[]
  tasks              Task[]
  workers            Worker[]
}

model Worker {
  id           String       @id @default(uuid())
  name         String
  trade        String
  badgeId      String       @unique
  status       String       @default("Active")
  companyId    String
  projectId    String?
  contractorId String?
  phone        String?
  attendances  Attendance[]
  company      Company      @relation(fields: [companyId], references: [id])
  contractor   User?        @relation("ContractorWorkers", fields: [contractorId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
}

model Attendance {
  id                  String    @id @default(uuid())
  workerId            String
  date                String
  checkIn             DateTime?
  checkOut            DateTime?
  status              String
  contractorId        String?
  createdAt           DateTime  @default(now())
  method              String
  projectId           String
  recordedById        String?
  totalHours          Float?
  updatedAt           DateTime  @updatedAt
  verificationRemarks String?
  verificationStatus  String    @default("Pending Verification")
  verificationTime    DateTime?
  verifiedById        String?
  contractor          User?     @relation("ContractorAttendances", fields: [contractorId], references: [id])
  project             Project   @relation(fields: [projectId], references: [id])
  recordedBy          User?     @relation("RecordedAttendances", fields: [recordedById], references: [id])
  verifiedBy          User?     @relation("VerifiedAttendances", fields: [verifiedById], references: [id])
  worker              Worker    @relation(fields: [workerId], references: [id])

  @@unique([workerId, projectId, date])
}

model Material {
  id           String                      @id @default(uuid())
  name         String
  category     String
  unit         String
  stock        Float                       @default(0)
  minThreshold Float                       @default(0)
  companyId    String
  company      Company                     @relation(fields: [companyId], references: [id])
  receipts     MaterialReceipt[]
  requests     MaterialRequest[]
  allocations  ProjectMaterialAllocation[]
}

model MaterialRequest {
  id                  String   @id @default(uuid())
  materialId          String
  projectId           String
  requestedBy         String
  qty                 Float
  status              String   @default("PENDING")
  requestDate         DateTime @default(now())
  purpose             String?
  isExcess            Boolean  @default(false)
  excessQty           Float    @default(0)
  approvedQuota       Float    @default(0)
  previouslyIssued    Float    @default(0)
  excessJustification String?
  rejectionReason     String?
  reviewerName        String?
  
  // New fields for WhatsApp integration
  requiredDate        DateTime?
  priority            String   @default("Medium")
  location            String?
  reason              String?
  waMessageId         String?
  waStatus            String?
  waFailureReason     String?
  waSentAt            DateTime?

  material            Material @relation(fields: [materialId], references: [id])
  project             Project  @relation(fields: [projectId], references: [id])
  histories           MaterialRequestHistory[]
}

model ProjectMaterialAllocation {
  id           String   @id @default(uuid())
  projectId    String
  materialId   String
  allocatedQty Float
  issuedQty    Float    @default(0)
  material     Material @relation(fields: [materialId], references: [id])
  project      Project  @relation(fields: [projectId], references: [id])

  @@unique([projectId, materialId])
}

model Vendor {
  id             String          @id @default(uuid())
  name           String
  category       String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  rating         Float?          @default(5.0)
  status         String          @default("ACTIVE")
  companyId      String
  purchaseOrders PurchaseOrder[]
  company        Company         @relation(fields: [companyId], references: [id])
}

model PurchaseOrder {
  id          String            @id @default(uuid())
  poNumber    String?
  vendorId    String
  projectId   String
  totalAmount Float
  items       Json?
  status      String            @default("DRAFT")
  orderDate   DateTime          @default(now())
  receipts    MaterialReceipt[]
  project     Project           @relation(fields: [projectId], references: [id])
  vendor      Vendor            @relation(fields: [vendorId], references: [id])
}

model Equipment {
  id              String    @id @default(uuid())
  name            String
  type            String
  status          String    @default("Available")
  companyId       String
  projectId       String?
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  company         Company   @relation(fields: [companyId], references: [id])
  project         Project?  @relation(fields: [projectId], references: [id])
}

model Issue {
  id          String   @id @default(uuid())
  title       String
  category    String
  severity    String
  status      String   @default("Open")
  description String
  reportedBy  String
  projectId   String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])
}

model Task {
  id                String              @id @default(uuid())
  title             String
  status            String              @default("Pending")
  priority          String              @default("Medium")
  progressPct       Float               @default(0)
  contractorId      String?
  actualStart       DateTime?
  actualEnd         DateTime?
  dueDate           DateTime?
  assigneeId        String?
  projectId         String
  DailySiteReport   DailySiteReport[]
  QualityInspection QualityInspection[]
  SitePhoto         SitePhoto[]
  assignee          User?               @relation(fields: [assigneeId], references: [id])
  project           Project             @relation(fields: [projectId], references: [id])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorName     String
  actorRole     String
  action        String
  entity        String
  entityId      String
  previousValue String?
  newValue      String?
  reason        String?
  projectId     String?
  timestamp     DateTime @default(now())
}

model DailyProgress {
  id             String   @id @default(uuid())
  projectId      String
  date           String
  progressPct    Float
  completed      String
  workersPresent Int      @default(0)
  issues         String?
  mediaUrls      String[] @default([])
  companyId      String
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id])
  project        Project  @relation(fields: [projectId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  projectId   String
  category    String
  description String
  date        String
  amount      Float
  companyId   String
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id])
  project     Project  @relation(fields: [projectId], references: [id])
}

model MaterialMarketPrice {
  id            String                 @id @default(uuid())
  materialName  String
  brand         String?
  specification String?
  unit          String
  price         Float
  minPrice      Float?
  maxPrice      Float?
  city          String                 @default("Madurai")
  district      String                 @default("Madurai")
  state         String                 @default("Tamil Nadu")
  country       String                 @default("India")
  sourceName    String
  sourceUrl     String?
  publishedAt   DateTime?
  retrievedAt   DateTime               @default(now())
  status        String                 @default("FRESH")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  history       MaterialPriceHistory[]
}

model MaterialPriceHistory {
  id            String              @id @default(uuid())
  marketPriceId String
  price         Float
  unit          String
  city          String
  district      String
  state         String
  country       String
  sourceName    String
  sourceUrl     String?
  retrievedAt   DateTime            @default(now())
  createdAt     DateTime            @default(now())
  marketPrice   MaterialMarketPrice @relation(fields: [marketPriceId], references: [id], onDelete: Cascade)
}

model MaterialReceipt {
  id             String        @id @default(uuid())
  poId           String
  materialId     String
  orderedQty     Float
  deliveredQty   Float
  isMismatch     Boolean       @default(false)
  mismatchReason String?
  receivedBy     String
  status         String        @default("VERIFIED")
  dateReceived   DateTime      @default(now())
  material       Material      @relation(fields: [materialId], references: [id])
  purchaseOrder  PurchaseOrder @relation(fields: [poId], references: [id])
}

model DailySiteReport {
  id              String   @id @default(uuid())
  projectId       String
  date            DateTime @default(now())
  taskId          String?
  workDescription String
  progressPct     Float
  manpowerCount   Int      @default(0)
  remarks         String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id])
  task            Task?    @relation(fields: [taskId], references: [id])
}

model SitePhoto {
  id          String   @id @default(uuid())
  projectId   String
  taskId      String?
  url         String
  description String?
  uploadedBy  String
  uploadDate  DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])
  task        Task?    @relation(fields: [taskId], references: [id])
}

model QualityInspection {
  id               String   @id @default(uuid())
  projectId        String
  taskId           String?
  activity         String
  status           String   @default("Needs Attention")
  remarks          String?
  photoUrl         String?
  correctiveAction String?
  inspectedBy      String
  inspectionDate   DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id])
  task             Task?    @relation(fields: [taskId], references: [id])
}

model SafetyReport {
  id               String   @id @default(uuid())
  projectId        String
  description      String
  severity         String   @default("Medium")
  photoUrl         String?
  location         String?
  correctiveAction String?
  status           String   @default("Open")
  reportedBy       String
  reportDate       DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  userId    String
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}


model MaterialRequestHistory {
  id              String   @id @default(uuid())
  requestId       String
  status          String
  changedById     String
  remarks         String?
  createdAt       DateTime @default(now())
  request         MaterialRequest @relation(fields: [requestId], references: [id])
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  SITE_ENGINEER
  CONTRACTOR
  CLIENT
  STORE_MANAGER
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}
